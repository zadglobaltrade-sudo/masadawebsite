---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const contactInfo = [
  {
    icon: 'location',
    title: 'Office Address',
    details: 'Masada Fruits and Vegetables<br>Pune, Maharashtra, India'
  },
  {
    icon: 'phone',
    title: 'Phone',
    details: '+91 9028593765'
  },
  {
    icon: 'email',
    title: 'Email',
    details: 'dalim@masadafruits.com'
  },
  {
    icon: 'clock',
    title: 'Business Hours',
    details: 'Monday - Saturday<br>9:00 AM - 6:00 PM IST'
  }
];
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contact Us — Masada Fruits &amp; Vegetables</title>
  <meta name="description" content="Get in touch with Masada Fruits and Vegetables for export inquiries, partnerships, and general information about our banana export services." />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />
</head>
<body>
  <Header />

  <main>
    <!-- PAGE HEADER -->
    <section class="contact-hero">
      <div class="container reveal">
        <div class="breadcrumb label-sm">
          <a href="/">Home</a>
          <span class="sep">/</span>
          <span class="current">Contact</span>
        </div>
        <h1 class="display-lg">Contact Us</h1>
        <p class="body-xl hero-sub">
          Reach out to our Pune export desk for inquiries, partnerships,
          and general information about our banana export services.
        </p>
      </div>
    </section>

    <!-- CONTACT INFO GRID -->
    <section class="contact-info">
      <div class="container">
        <div class="info-grid reveal">
          {contactInfo.map((item, i) => (
            <div class="info-card" style={`--i:${i}`}>
              <div class="info-icon">
                {item.icon === 'location' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                )}
                {item.icon === 'phone' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.7 2Z"/></svg>
                )}
                {item.icon === 'email' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                )}
                {item.icon === 'clock' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                )}
              </div>
              <h3 class="headline-sm">{item.title}</h3>
              <p class="body-md" set:html={item.details}></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CONTACT FORM -->
    <section class="contact-form-section" id="contact-form-section">
      <div class="container">
        <div class="form-wrapper reveal">
          <div class="form-header">
            <div class="eyebrow-row">
              <span class="dot"></span>
              <span class="label-caps eyebrow">Get in Touch</span>
            </div>
            <h2 class="headline-xl">Send us a message</h2>
            <p class="body-md">
              Fill out the form below and our export desk will respond within 12 business hours.
              For urgent matters, please call us directly.
            </p>
          </div>

          <form id="contact-form">
            <div class="form-row">
              <div class="field">
                <label class="label-sm" for="name">Full Name</label>
                <input id="name" name="name" type="text" placeholder="Your name" autocomplete="name" required />
              </div>
              <div class="field">
                <label class="label-sm" for="company">Company Name</label>
                <input id="company" name="company" type="text" placeholder="Your company" autocomplete="organization" />
              </div>
            </div>
            <div class="form-row">
              <div class="field">
                <label class="label-sm" for="email">Email Address</label>
                <input id="email" name="email" type="email" placeholder="you@company.com" autocomplete="email" required />
              </div>
              <div class="field">
                <label class="label-sm" for="phone">Phone Number</label>
                <input id="phone" name="phone" type="tel" placeholder="+91 XXXXX XXXXX" autocomplete="tel" />
              </div>
            </div>
            <div class="field">
              <label class="label-sm" for="subject">Subject</label>
              <select id="subject" name="subject" required>
                <option value="">Select a subject</option>
                <option value="export-inquiry">Export Inquiry</option>
                <option value="partnership">Partnership Opportunity</option>
                <option value="general">General Information</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div class="field">
              <label class="label-sm" for="message">Message</label>
              <textarea id="message" name="message" rows="5" placeholder="How can we help you?" required></textarea>
            </div>
            <div class="form-footer">
              <button type="submit" class="btn btn-primary">
                Send Message
                <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <span class="body-sm">We typically respond within 12 business hours.</span>
            </div>
            <p class="form-success body-sm" id="contact-success" hidden>
              Thank you for your message! Our export desk will get back to you within 12 business hours.
            </p>
          </form>
        </div>
      </div>
    </section>

    <!-- MAP SECTION -->
    <section class="map-section">
      <div class="container reveal">
        <div class="map-content">
          <div class="map-header">
            <h2 class="headline-xl">Visit Our Office</h2>
            <p class="body-md">
              Located in Pune, Maharashtra — the heart of India's banana growing region.
              Schedule a visit to see our operations firsthand.
            </p>
          </div>
          <div class="map-embed">
            <iframe
              src="https://www.google.com/maps?q=INOX+Jai+Ganesh+Vision+Mall,+Akurdi+Chowk,+Shubhashri+Residency,+Ganga+Nagar,+Akurdi,+Pune,+Pimpri-Chinchwad,+Maharashtra+411035&output=embed"
              width="100%"
              height="400"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    /* ---------- Hero ---------- */
    .contact-hero { background: var(--color-primary); color: var(--color-on-primary); padding-block: 4.5rem 3.5rem; }
    @media (min-width: 1024px) { .contact-hero { padding-block: 6rem 5rem; } }
    .breadcrumb { display: flex; align-items: center; gap: 0.5rem; color: var(--color-tertiary-fixed); margin-bottom: 1.5rem; }
    .breadcrumb a { color: var(--color-on-primary-container); }
    .breadcrumb a:hover { color: var(--color-on-primary); }
    .breadcrumb .sep { opacity: 0.4; }
    .contact-hero h1 { color: var(--color-on-primary); margin: 0 0 1rem; }
    .hero-sub { color: var(--color-tertiary-fixed); max-width: 42rem; margin: 0; }

    /* ---------- Contact Info ---------- */
    .contact-info { background: var(--color-surface); padding-block: 5rem; }
    @media (min-width: 1024px) { .contact-info { padding-block: 7rem; } }
    .info-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
    @media (min-width: 640px) { .info-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 1024px) { .info-grid { grid-template-columns: repeat(4, 1fr); } }

    .info-card {
      padding: 2rem; border-radius: var(--radius-lg);
      background: var(--color-surface-container-low);
      border: 1px solid var(--color-outline-variant);
      text-align: center;
      transition: transform var(--dur-fast) var(--ease-standard), box-shadow var(--dur-fast) var(--ease-standard);
    }
    .info-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(1, 45, 29, 0.08); }

    .info-icon {
      width: 56px; height: 56px; border-radius: var(--radius-full);
      background: var(--color-secondary-container); color: var(--color-primary);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 1.25rem;
    }
    .info-card h3 { color: var(--color-primary); margin: 0 0 0.75rem; }
    .info-card p { color: var(--color-on-surface-variant); margin: 0; }

    /* ---------- Contact Form ---------- */
    .contact-form-section { background: var(--color-surface-container-low); padding-block: 5rem; }
    @media (min-width: 1024px) { .contact-form-section { padding-block: 7rem; } }
    .form-wrapper {
      max-width: 42rem; margin: 0 auto;
      background: var(--color-surface-container-lowest); border-radius: var(--radius-lg);
      padding: 2.5rem; border: 1px solid var(--color-outline-variant);
      box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    }
    @media (min-width: 768px) { .form-wrapper { padding: 3.5rem; } }

    .eyebrow-row { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; }
    .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--color-tertiary-container); }
    .eyebrow { color: var(--color-secondary); font-weight: 700; }
    .form-header h2 { color: var(--color-primary); margin: 0.5rem 0 1rem; }
    .form-header > p { color: var(--color-on-surface-variant); margin: 0; }

    .form-row { display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: 1.5rem; }
    @media (min-width: 640px) { .form-row { grid-template-columns: 1fr 1fr; } }
    .field { margin-bottom: 1.5rem; }
    .form-row .field { margin-bottom: 0; }
    .field label { display: block; color: var(--color-primary); margin-bottom: 0.5rem; }
    .field input, .field textarea, .field select {
      width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-md);
      border: 1px solid transparent; background: var(--color-surface-container-low);
      color: var(--color-on-surface); font-size: 14px; resize: none;
      transition: background var(--dur-fast) var(--ease-standard), box-shadow var(--dur-fast) var(--ease-standard);
    }
    .field input:focus, .field textarea:focus, .field select:focus {
      outline: none; background: var(--color-surface-container-lowest);
      box-shadow: 0 0 0 2px var(--color-secondary-container);
    }
    .field select { cursor: pointer; }

    .form-footer {
      display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
      gap: 1rem; padding-top: 0.5rem;
    }
    .form-footer .body-sm { color: var(--color-on-surface-variant); }
    .form-success {
      margin-top: 1.25rem; padding: 0.9rem 1rem; border-radius: var(--radius-md);
      background: var(--color-secondary-container); color: var(--color-on-secondary-fixed);
    }

    /* ---------- Map Section ---------- */
    .map-section { background: var(--color-surface); padding-block: 5rem; }
    @media (min-width: 1024px) { .map-section { padding-block: 7rem; } }
    .map-content { max-width: 44rem; margin: 0 auto; text-align: center; }
    .map-header h2 { color: var(--color-primary); margin: 0 0 1rem; }
    .map-header p { color: var(--color-on-surface-variant); margin: 0 0 2rem; }

    .map-embed {
      border-radius: var(--radius-lg);
      overflow: hidden;
      border: 1px solid var(--color-outline-variant);
    }
    .map-embed iframe {
      width: 100%;
      height: 400px;
      display: block;
    }
  </style>

  <script>
    const revealEls = document.querySelectorAll('.reveal');
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
    );
    revealEls.forEach((el) => revealObserver.observe(el));

    // Smooth scroll to form section if URL has hash
    if (window.location.hash === '#contact-form-section') {
      const formSection = document.getElementById('contact-form-section');
      if (formSection) {
        setTimeout(() => {
          formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 100);
      }
    }

    // Contact form: placeholder submit handler
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const success = document.getElementById('contact-success');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      success?.removeAttribute('hidden');
      form.reset();
    });
  </script>
</body>
</html>