---
import { Image } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import dalimPhoto from '@/assets/team/dalim.jpg';

// Add more people here later — the layout below adapts automatically
// whether there's 1 person or several.
const team = [
  {
    name: 'Dalim Abdul Shaikh',
    title: 'Managing Director',
    photo: dalimPhoto,
    email: 'dalim@masadafruits.com',
    phone: '+91 9028593765',
    chips: ['CEO/Managing Director', 'Pune, Maharashtra'],
    bio: 'Dalim leads Masada Fruits and Vegetables with hands-on expertise across the entire export supply chain — from nurturing farmer partnerships across Maharashtra to ensuring seamless cold-chain delivery to international markets.',
  },
];
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Team — Masada Fruits &amp; Vegetables</title>
  <meta name="description" content="Meet the leadership behind Masada Fruits and Vegetables' banana export operations." />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />
</head>
<body>
  <Header />

  <main>
    <!-- PAGE HEADER (lighter treatment than About/Products, for variety) -->
    <section class="team-hero">
      <div class="container reveal">
        <div class="breadcrumb label-sm">
          <a href="/">Home</a>
          <span class="sep">/</span>
          <span class="current">Team</span>
        </div>
        <h1 class="display-lg">Leadership</h1>
        <span class="rule"></span>
        <p class="body-xl hero-sub">
          The people behind Masada's day-to-day export operations.
        </p>
      </div>
    </section>

    <!-- TEAM GRID -->
    <section class="team-section">
      <div class="container">
        <div class={`team-grid ${team.length === 1 ? 'is-single' : ''}`}>
          {team.map((person, i) => (
            <div class="person-card reveal" style={`--i:${i}`}>
              <div class="person-photo-wrap">
                <Image src={person.photo} alt={person.name} width={200} height={220} />
              </div>
              <div class="person-info">
                <h2 class="headline-lg">{person.name}</h2>
                <p class="label-caps person-title">{person.title}</p>

                <div class="chip-row">
                  {person.chips.map((c) => (
                    <span class="chip label-sm">{c}</span>
                  ))}
                </div>

                <p class="body-md person-bio">{person.bio}</p>

                <div class="contact-row">
                  <a href={`mailto:${person.email}`} class="contact-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                    {person.email}
                  </a>
                  <a href={`tel:${person.phone}`} class="contact-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.7 2Z"/></svg>
                    {person.phone}
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    /* ---------- Hero: light, editorial, different from About/Products ---------- */
    .team-hero { background: var(--color-surface); padding-block: 5rem 3rem; }
    @media (min-width: 1024px) { .team-hero { padding-block: 7rem 4rem; } }
    .breadcrumb { display: flex; align-items: center; gap: 0.5rem; color: var(--color-on-surface-variant); margin-bottom: 1.5rem; }
    .breadcrumb a { color: var(--color-secondary); }
    .breadcrumb a:hover { color: var(--color-primary); }
    .breadcrumb .sep { opacity: 0.4; }
    .team-hero h1 { color: var(--color-primary); margin: 0; }
    .rule { display: block; width: 3.5rem; height: 4px; background: var(--color-tertiary-container); border-radius: var(--radius-full); margin: 1.25rem 0 1.5rem; }
    .hero-sub { color: var(--color-on-surface-variant); margin: 0; }

    /* ---------- Team grid ---------- */
    .team-section { background: var(--color-surface); padding-block: 1rem 6rem; }
    .team-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
    @media (min-width: 900px) { .team-grid { grid-template-columns: repeat(2, 1fr); } }
    .team-grid.is-single { grid-template-columns: 1fr; max-width: 44rem; margin-inline: auto; }

    .person-card {
      display: flex; flex-direction: column; gap: 1.75rem;
      padding: 2rem; border-radius: var(--radius-lg);
      background: var(--color-surface-container-low);
      border: 1px solid var(--color-outline-variant);
    }
    @media (min-width: 640px) {
      .team-grid.is-single .person-card { flex-direction: row; align-items: flex-start; padding: 2.5rem; }
    }

    .person-photo-wrap {
      width: 140px; flex-shrink: 0; border-radius: var(--radius-md);
      overflow: hidden; border: 3px solid var(--color-surface-container-lowest);
      box-shadow: 0 6px 18px rgba(1, 45, 29, 0.12);
      margin-inline: auto;
    }
    @media (min-width: 640px) {
      .team-grid.is-single .person-photo-wrap { margin-inline: 0; }
    }
    .person-photo-wrap :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }

    .person-info { text-align: center; }
    @media (min-width: 640px) {
      .team-grid.is-single .person-info { text-align: left; }
    }
    .person-info h2 { color: var(--color-primary); margin: 0 0 0.3rem; }
    .person-title { color: var(--color-secondary); font-weight: 700; margin: 0 0 1.25rem; }

    .chip-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; justify-content: center; }
    @media (min-width: 640px) {
      .team-grid.is-single .chip-row { justify-content: flex-start; }
    }
    .chip {
      padding: 0.3rem 0.75rem; border-radius: var(--radius-full);
      background: var(--color-surface-container-high); color: var(--color-primary);
      font-weight: 600;
    }

    .person-bio { color: var(--color-on-surface-variant); margin: 0 0 1.5rem; }

    .contact-row { display: flex; flex-direction: column; gap: 0.6rem; align-items: center; }
    @media (min-width: 640px) {
      .team-grid.is-single .contact-row { align-items: flex-start; }
    }
    .contact-link {
      display: inline-flex; align-items: center; gap: 0.5rem;
      color: var(--color-primary); font-size: 14px; font-weight: 500;
      transition: color var(--dur-fast) var(--ease-standard);
    }
    .contact-link:hover { color: var(--color-secondary); }
  </style>

  <script>
    const revealEls = document.querySelectorAll('.reveal');
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
    );
    revealEls.forEach((el) => revealObserver.observe(el));
  </script>
</body>
</html>