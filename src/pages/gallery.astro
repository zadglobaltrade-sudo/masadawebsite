---
import { Image } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { galleryVideos } from '../data/gallery-videos.js';

// Auto-pick-up every image dropped into src/assets/gallery/photos/
// Sorted by filename, so prefix files like 01-harvest.jpg, 02-packing.jpg
// to control the order they appear in.
const photoFiles = import.meta.glob('/src/assets/gallery/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const photos = Object.entries(photoFiles)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({
    src: (mod as any).default,
    alt: 'Gallery photo',
  }));
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Image Gallery — Masada Fruits &amp; Vegetables</title>
  <meta name="description" content="Photos and videos from Masada Fruits and Vegetables' harvest, packing, and export operations." />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />
</head>
<body>
  <Header />

  <main>
    <!-- PAGE HEADER -->
    <section class="gallery-hero">
      <div class="container reveal">
        <div class="breadcrumb label-sm">
          <a href="/">Home</a>
          <span class="sep">/</span>
          <span class="current">Image Gallery</span>
        </div>
        <h1 class="display-lg">Gallery</h1>
        <p class="body-xl hero-sub">
          A look inside our harvest, packing, and export operations —
          straight from the field to the port.
        </p>
      </div>
    </section>

    <!-- TABS -->
    <section class="gallery-body">
      <div class="container">
        <div class="tab-row reveal">
          <button class="tab-btn is-active" data-tab="photos" type="button">
            Photos <span class="tab-count">{photos.length}</span>
          </button>
          <button class="tab-btn" data-tab="videos" type="button">
            Videos <span class="tab-count">{galleryVideos.length}</span>
          </button>
        </div>

        <!-- PHOTOS PANEL -->
        <div class="tab-panel is-active" data-panel="photos">
          {photos.length === 0 ? (
            <div class="empty-state">
              <p class="body-md">No photos yet.</p>
              <p class="body-sm">Drop image files into <code>src/assets/gallery/photos/</code> and they'll appear here automatically — no code changes needed.</p>
            </div>
          ) : (
            <div class="photo-grid">
              {photos.map((p, i) => (
                <button class="photo-tile reveal" style={`--i:${i % 8}`} data-lightbox-index={i} type="button">
                  <Image src={p.src} alt={p.alt} width={480} height={480} loading="lazy" />
                </button>
              ))}
            </div>
          )}
        </div>

        <!-- VIDEOS PANEL -->
        <div class="tab-panel" data-panel="videos">
          {galleryVideos.length === 0 ? (
            <div class="empty-state">
              <p class="body-md">No videos yet.</p>
            </div>
          ) : (
            <div class="video-grid">
              {galleryVideos.map((v, i) => (
                <div class="video-tile reveal" style={`--i:${i % 8}`} data-video-id={v.id}>
                  <button class="video-thumb" type="button" aria-label={`Play ${v.title}`}>
                    <img src={`https://img.youtube.com/vi/${v.id}/hqdefault.jpg`} alt={v.title} loading="lazy" />
                    <span class="play-btn">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7-11-7Z"/></svg>
                    </span>
                  </button>
                  <p class="body-sm video-title">{v.title}</p>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <!-- LIGHTBOX -->
  <div class="lightbox" id="lightbox" aria-hidden="true">
    <button class="lightbox-close" id="lightbox-close" aria-label="Close">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
    <button class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Previous">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <img class="lightbox-img" id="lightbox-img" src="" alt="" />
    <button class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Next">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>

  <style>
    /* ---------- Hero ---------- */
    .gallery-hero { background: var(--color-primary); color: var(--color-on-primary); padding-block: 4.5rem 3rem; }
    @media (min-width: 1024px) { .gallery-hero { padding-block: 6rem 4rem; } }
    .breadcrumb { display: flex; align-items: center; gap: 0.5rem; color: var(--color-tertiary-fixed); margin-bottom: 1.5rem; }
    .breadcrumb a { color: var(--color-on-primary-container); }
    .breadcrumb a:hover { color: var(--color-on-primary); }
    .breadcrumb .sep { opacity: 0.4; }
    .gallery-hero h1 { color: var(--color-on-primary); margin: 0 0 1rem; }
    .hero-sub { color: var(--color-tertiary-fixed); max-width: 36rem; margin: 0; }

    /* ---------- Tabs ---------- */
    .gallery-body { background: var(--color-surface); padding-block: 3.5rem 5rem; }
    .tab-row { display: flex; gap: 0.75rem; margin-bottom: 2.5rem; }
    .tab-btn {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.65rem 1.25rem; border-radius: var(--radius-full);
      border: 1px solid var(--color-outline-variant);
      background: transparent; color: var(--color-on-surface-variant);
      font-size: 14px; font-weight: 600; cursor: pointer;
      transition: all var(--dur-fast) var(--ease-standard);
    }
    .tab-btn:hover { border-color: var(--color-primary-container); color: var(--color-primary); }
    .tab-btn.is-active { background: var(--color-primary-container); border-color: var(--color-primary-container); color: var(--color-on-primary); }
    .tab-count {
      font-size: 11px; padding: 0.1rem 0.45rem; border-radius: var(--radius-full);
      background: rgba(0,0,0,0.08);
    }
    .tab-btn.is-active .tab-count { background: rgba(255,255,255,0.25); }

    .tab-panel { display: none; }
    .tab-panel.is-active { display: block; }

    .empty-state {
      padding: 3.5rem 2rem; text-align: center; border-radius: var(--radius-lg);
      background: var(--color-surface-container-low); border: 1px dashed var(--color-outline-variant);
    }
    .empty-state p.body-md { color: var(--color-primary); margin: 0 0 0.5rem; font-weight: 600; }
    .empty-state p.body-sm { color: var(--color-on-surface-variant); margin: 0; }
    .empty-state code {
      background: var(--color-surface-container-high); padding: 0.15rem 0.4rem;
      border-radius: 4px; font-size: 13px;
    }

    /* ---------- Photo grid ---------- */
    .photo-grid {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem;
    }
    @media (min-width: 640px) { .photo-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (min-width: 1024px) { .photo-grid { grid-template-columns: repeat(4, 1fr); } }

    .photo-tile {
      position: relative; aspect-ratio: 1/1; border-radius: var(--radius-md);
      overflow: hidden; border: none; padding: 0; cursor: pointer;
      background: var(--color-surface-container-low);
      transition-delay: calc(var(--i) * 60ms);
    }
    .photo-tile :global(img) {
      width: 100%; height: 100%; object-fit: cover;
      transition: transform var(--dur-med) var(--ease-standard);
    }
    .photo-tile:hover :global(img) { transform: scale(1.08); }
    .photo-tile::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(1,45,29,0.35), transparent 50%);
      opacity: 0; transition: opacity var(--dur-fast) var(--ease-standard);
    }
    .photo-tile:hover::after { opacity: 1; }

    /* ---------- Video grid ---------- */
    .video-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
    @media (min-width: 640px) { .video-grid { grid-template-columns: 1fr 1fr; } }
    @media (min-width: 1024px) { .video-grid { grid-template-columns: repeat(3, 1fr); } }

    .video-tile { transition-delay: calc(var(--i) * 80ms); }
    .video-thumb {
      position: relative; width: 100%; aspect-ratio: 16/9;
      border-radius: var(--radius-lg); overflow: hidden; border: none; padding: 0; cursor: pointer;
      background: var(--color-primary);
    }
    .video-thumb img { width: 100%; height: 100%; object-fit: cover; opacity: 0.9; transition: transform var(--dur-med) var(--ease-standard); }
    .video-thumb:hover img { transform: scale(1.05); }
    .play-btn {
      position: absolute; inset: 0; margin: auto; width: 52px; height: 52px;
      border-radius: 50%; background: rgba(249, 249, 255, 0.92); color: var(--color-primary);
      display: flex; align-items: center; justify-content: center;
      transition: transform var(--dur-fast) var(--ease-standard);
    }
    .video-thumb:hover .play-btn { transform: scale(1.1); }
    .video-tile iframe { width: 100%; aspect-ratio: 16/9; border-radius: var(--radius-lg); border: none; }
    .video-title { color: var(--color-primary); margin: 0.75rem 0 0; font-weight: 500; }

    /* ---------- Lightbox ---------- */
    .lightbox {
      position: fixed; inset: 0; z-index: 100;
      background: rgba(1, 15, 10, 0.92);
      display: flex; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none;
      transition: opacity var(--dur-med) var(--ease-standard);
    }
    .lightbox.is-open { opacity: 1; pointer-events: auto; }
    .lightbox-img {
      max-width: 88vw; max-height: 82vh; border-radius: var(--radius-md);
      transform: scale(0.96); transition: transform var(--dur-med) var(--ease-standard);
    }
    .lightbox.is-open .lightbox-img { transform: scale(1); }

    .lightbox-close, .lightbox-nav {
      position: absolute; display: flex; align-items: center; justify-content: center;
      width: 44px; height: 44px; border-radius: 50%; border: none;
      background: rgba(255,255,255,0.1); color: #fff; cursor: pointer;
      transition: background var(--dur-fast) var(--ease-standard);
    }
    .lightbox-close:hover, .lightbox-nav:hover { background: rgba(255,255,255,0.2); }
    .lightbox-close { top: 1.5rem; right: 1.5rem; }
    .lightbox-prev { left: 1.5rem; top: 50%; transform: translateY(-50%); }
    .lightbox-next { right: 1.5rem; top: 50%; transform: translateY(-50%); }
    @media (max-width: 640px) {
      .lightbox-prev { left: 0.5rem; }
      .lightbox-next { right: 0.5rem; }
    }
  </style>

  <script>
    // ---------- Scroll reveal ----------
    const revealEls = document.querySelectorAll('.reveal');
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );
    revealEls.forEach((el) => revealObserver.observe(el));

    // ---------- Tabs ----------
    const tabBtns = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.tab-panel');
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = (btn as HTMLElement).dataset.tab;
        tabBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
        panels.forEach((p) => p.classList.toggle('is-active', (p as HTMLElement).dataset.panel === target));
      });
    });

    // ---------- Lightbox ----------
    const tiles = Array.from(document.querySelectorAll('.photo-tile'));
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    let currentIndex = 0;

    const openLightbox = (index: number) => {
      if (!tiles.length) return;
      currentIndex = index;
      const img = tiles[currentIndex].querySelector('img') as HTMLImageElement;
      if (!img || !lightboxImg) return;
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
    };
    const closeLightbox = () => {
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
    };
    const showDelta = (delta: number) => {
      currentIndex = (currentIndex + delta + tiles.length) % tiles.length;
      const img = tiles[currentIndex].querySelector('img') as HTMLImageElement;
      if (!img || !lightboxImg) return;
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
    };

    tiles.forEach((tile, i) => tile.addEventListener('click', () => openLightbox(i)));
    document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
    document.getElementById('lightbox-prev')?.addEventListener('click', () => showDelta(-1));
    document.getElementById('lightbox-next')?.addEventListener('click', () => showDelta(1));
    lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
    window.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') showDelta(-1);
      if (e.key === 'ArrowRight') showDelta(1);
    });

    // ---------- YouTube facade: only load the iframe on click ----------
    document.querySelectorAll('.video-thumb').forEach((btn) => {
      btn.addEventListener('click', () => {
        const tile = btn.closest('.video-tile');
        const id = tile.dataset.videoId;
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1`;
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        btn.replaceWith(iframe);
      });
    });
  </script>
</body>
</html>