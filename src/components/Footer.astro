---
// Footer.astro
const certifications = [
  'APEDA Registered Exporter',
  'FSSAI Licensed Facility',
  'ISO 22000 Compliant',
  'Phytosanitary Protocol Verified',
];
const navGroups = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Our Products', href: '/products' },
  { label: 'Team', href: '/team' },
  { label: 'Image Gallery', href: '/gallery' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-eyebrow">
          <span class="dot"></span>
          <span class="label-caps">Global Agro Infrastructure</span>
        </div>
        <h2 class="headline-lg">Masada Fruits &amp; Vegetables</h2>
        <p class="body-md footer-desc">
          Precision wholesale produce supply and temperature-controlled global
          export logistics, exported to institutional standards worldwide.
        </p>
        <div class="footer-hq">
          <p class="label-caps hq-label">Corporate Headquarters</p>
          <p class="body-sm">Pune, Maharashtra, India</p>
        </div>
      </div>

      <div class="footer-col">
        <p class="label-caps col-label">Navigation</p>
        <ul>
          {navGroups.map((n) => (
            <li><a href={n.href}>{n.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <p class="label-caps col-label">Certifications</p>
        <ul class="cert-list">
          {certifications.map((c) => (
            <li><span class="dot"></span>{c}</li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <p class="label-caps col-label">Desk Direct</p>
        <div class="contact-block">
          <span class="label-caps contact-label">Commercial Inquiries</span>
          <p class="body-sm"><a href="mailto:info@masadafruits.com">info@masadafruits.com</a></p>
        </div>
        <div class="contact-block">
          <span class="label-caps contact-label">Pune Operations Desk</span>
          <p class="body-sm">+91 9028593765</p>
        </div>
        <div class="social-row">
          <a href="#" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.5 9.9v-7H7.9V12h2.6V9.8c0-2.6 1.5-4 3.9-4 1.1 0 2.3.2 2.3.2v2.5h-1.3c-1.3 0-1.7.8-1.7 1.6V12h2.9l-.5 2.9h-2.4v7A10 10 0 0 0 22 12Z"/></svg>
          </a>
          <a href="#" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
          </a>
          <a href="#" aria-label="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M6.94 8.5H3.56V21h3.38V8.5ZM5.25 3a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92ZM21 21v-6.86c0-3.28-1.75-4.8-4.08-4.8-1.88 0-2.72 1.03-3.19 1.76V8.5H10.4c.04.9 0 12.5 0 12.5h3.33v-6.98c0-.37.03-.75.14-1.02.3-.75 1-1.53 2.16-1.53 1.53 0 2.14 1.16 2.14 2.87V21H21Z"/></svg>
          </a>
          <a href="#" aria-label="YouTube">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.5-.45-5.15a2.9 2.9 0 0 0-2.04-2.05C18.9 4.3 12 4.3 12 4.3s-6.9 0-8.5.5A2.9 2.9 0 0 0 1.45 6.85 30.6 30.6 0 0 0 1 12a30.6 30.6 0 0 0 .45 5.15 2.9 2.9 0 0 0 2.05 2.05c1.6.5 8.5.5 8.5.5s6.9 0 8.5-.5a2.9 2.9 0 0 0 2.05-2.05A30.6 30.6 0 0 0 23 12ZM9.75 15.5v-7l6 3.5-6 3.5Z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="label-sm">&copy; {new Date().getFullYear()} Masada Fruits and Vegetables. Pune, India. All rights reserved.</p>
      <div class="label-sm footer-tags">
        <span class="label-caps tag-gold">Precision Agriculture</span>
        <span class="sep">&middot;</span>
        <span>Strict Cold-Chain Logistics</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }
  .footer-inner { padding-block: 5rem; }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }
  @media (min-width: 768px) {
    .footer-grid { grid-template-columns: 2fr 1fr 1fr 1fr; }
  }

  .footer-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--color-tertiary-fixed-dim);
    display: inline-block;
    flex-shrink: 0;
  }
  .footer-eyebrow .label-caps { color: var(--color-tertiary-fixed); font-weight: 700; }

  .footer-desc {
    color: var(--color-on-primary-container);
    max-width: 30rem;
    margin: 0.75rem 0 1.5rem;
  }
  .hq-label { color: var(--color-tertiary-fixed); margin-bottom: 0.4rem; }

  .col-label { color: var(--color-tertiary-fixed); margin-bottom: 1rem; }
  .footer-col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .footer-col a {
    color: var(--color-on-primary-container);
    font-size: 14px;
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .footer-col a:hover { color: var(--color-on-primary); }

  .cert-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-on-primary-container);
    font-size: 12px;
  }
  .cert-list .dot { width: 6px; height: 6px; }

  .contact-block { margin-bottom: 1rem; }
  .contact-label { color: var(--color-on-primary-container); opacity: 0.7; display: block; margin-bottom: 0.2rem; }
  .contact-block p { margin: 0; color: var(--color-on-primary-container); }
  .contact-block a { color: var(--color-on-primary-container); text-decoration: none; transition: color var(--dur-fast) var(--ease-standard); }
  .contact-block a:hover { color: var(--color-on-primary); text-decoration: underline; }

  .social-row { display: flex; gap: 0.75rem; margin-top: 1rem; }
  .social-row a {
    width: 36px; height: 36px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 50%;
    background: rgba(255,255,255,0.08);
    color: var(--color-on-primary);
    transition: background var(--dur-fast) var(--ease-standard), transform var(--dur-fast) var(--ease-standard);
  }
  .social-row a:hover { background: rgba(255,255,255,0.18); transform: translateY(-2px); }

  .footer-bottom {
    padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,0.1);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    color: var(--color-on-primary-container);
  }
  @media (min-width: 640px) {
    .footer-bottom { flex-direction: row; align-items: center; justify-content: space-between; }
  }
  .footer-tags { display: flex; align-items: center; gap: 0.6rem; }
  .tag-gold { color: var(--color-tertiary-fixed); }
  .sep { opacity: 0.4; }
</style>